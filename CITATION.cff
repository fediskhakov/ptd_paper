    given-names: Wending
    affiliation: Australian National University
  - family-names: Iskhakov
    given-names: Fedor
    affiliation: Stony Brook University and Deakin University
version: "1.0.0"
license: MIT
repository-code: "https://github.com/fediskhakov/ptd_paper"
keywords:
  - dynamic programming
  - life-cycle model
  - safety net
  - consumption floor
  - non-convex dynamic optimization
  - policy-tree descendant algorithm
  - Julia
